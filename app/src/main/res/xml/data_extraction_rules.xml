<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="rafiq_prayer_log_store.xml" />
        <include domain="sharedpref" path="rafiq_prayer_schedule_store.xml" />
        <include domain="sharedpref" path="rafiq_permissions_prefs.xml" />
        <include domain="file" path="prayer_tracker_backup.json" />
        <include domain="file" path="datastore/rafiq_al_muslim_prefs.preferences_pb" />

        <exclude domain="file" path="offline_quran" />
        <exclude domain="file" path="offline_hadith" />
        <exclude domain="file" path="offline_tafsir" />
        <exclude domain="file" path="offline_adhan" />
        <exclude domain="file" path="offline_alerts" />
        <exclude domain="file" path="adhan" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="rafiq_prayer_log_store.xml" />
        <include domain="sharedpref" path="rafiq_prayer_schedule_store.xml" />
        <include domain="sharedpref" path="rafiq_permissions_prefs.xml" />
        <include domain="file" path="prayer_tracker_backup.json" />
        <include domain="file" path="datastore/rafiq_al_muslim_prefs.preferences_pb" />

        <exclude domain="file" path="offline_quran" />
        <exclude domain="file" path="offline_hadith" />
        <exclude domain="file" path="offline_tafsir" />
        <exclude domain="file" path="offline_adhan" />
        <exclude domain="file" path="offline_alerts" />
        <exclude domain="file" path="adhan" />
    </device-transfer>
</data-extraction-rules>
